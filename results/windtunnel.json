 "ruleSets": [
  {
   "id": "baseline",
   "label": "Baseline",
   "question": "The reference: reputation-weighted auction, upkeep 0.006 credits a tick, 7 tasks a tick, solvers resell 3 jobs a tick, no fee.",
   "rules": {}
  },
  {
   "id": "price-auction",
   "label": "Lowest price wins",
   "question": "What if the auction ignores reputation and the lowest bid wins?",
   "rules": {
    "auction": "price"
   }
  },
  {
   "id": "market-fee",
   "label": "10% market fee",
   "question": "What does a 10% fee on every paid task (back to the pool) do?",
   "rules": {
    "marketFee": 0.1
   }
  },
  {
   "id": "high-rent",
   "label": "Double upkeep",
   "question": "What if staying listed costs twice as much (upkeep 0.012 a tick)?",
   "rules": {
    "upkeep": 12000
   }
  },
  {
   "id": "scarce-demand",
   "label": "Scarce demand",
   "question": "What if buyers post 4 tasks a tick instead of 7?",
   "rules": {
    "tasksPerTick": 4
   }
  },
  {
   "id": "solver-capacity",
   "label": "Double solver capacity",
   "question": "What if the honest solvers can take 6 resold jobs a tick instead of 3?",
   "rules": {
    "solverSubCap": 6
   }
  }
 ],
