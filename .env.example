# Nothing here is needed for make demo, test, headless, seeds or ablation. The sim does not read this file;
# export the variables you want (or `set -a; . ./.env; set +a`).
PORT=8787
HOST=127.0.0.1
SEED=42
TICKS=2000
# Optional real LLM solvers (capped at DARWIN_LLM_MAX_CALLS); scripted solvers otherwise
ANTHROPIC_API_KEY=
DARWIN_LLM=0
DARWIN_LLM_MAX_CALLS=60
# Mutation operator: gaussian | llm | mixed. llm/mixed replay results/mutations/ first, then call a model, then fall back to Gaussian.
DARWIN_MUTATION=gaussian
# Optional OpenAI-compatible model for the mutation operator (e.g. free Mistral Large on NVIDIA NIM); Claude otherwise
MUTATION_BASE_URL=
MUTATION_API_KEY=
MUTATION_MODEL=
# Hard dollar cap on every Claude call
NEAR_LLM_BUDGET_USD=2.5
# Testnet bridge (make deploy / make checkpoint / make agents)
NEAR_ACCOUNT=
NEAR_PRIVATE_KEY=
# Live settler (make settler-key writes these): a FUNCTION-CALL key on settler-v2.<NEAR_ACCOUNT>, limited to
# market2 / transfer_internal. When both are set, the server mirrors the run's guard blocks on testnet (docs/TESTNET.md 6).
DARWIN_SETTLER_ACCOUNT=
DARWIN_SETTLER_KEY=
DARWIN_SETTLER_INTERVAL_SEC=45
# New epoch: once one family holds this share of agents for this many rounds, a public run restarts (0 = off)
DARWIN_EPOCH_SHARE=0.9
DARWIN_EPOCH_HOLD=100
